DISCORD_TOKEN=your_token_here

# Language: en (default) or de
LANGUAGE=en

# Terminal-Ausgabe: quiet (Default) = wesentliche Ereignisse (Songwechsel,
# Queue, Radio) + alle echten Probleme; debug = volle Diagnose inkl.
# Download-Pipeline. bot.log erhält IMMER die volle Diagnose.
# Zur Laufzeit umschaltbar mit !debug on|off.
LOG_MODE=quiet

# YouTube cookie auth (optional, one of the two)
YDL_COOKIES_FILE=/path/to/cookies.txt
YDL_BROWSER=firefox

# DM-Bridge (KI-Dungeon-Master): HTTP-Server, über den Bot B fertige Audiodateien
# zum Abspielen schickt. Localhost (Default) = Pfad-Modus. Für getrennte Maschinen
# DM_BRIDGE_HOST auf die Tailscale-/LAN-IP (oder 0.0.0.0) setzen; dann schickt Bot B
# die WAV-Bytes übers Netz und dieser Bot spielt seine eigene Kopie (ADR 010).
DM_BRIDGE_HOST=127.0.0.1
DM_BRIDGE_PORT=8765
# Shared Secret, Pflicht sobald nicht-localhost gebunden. Muss exakt DMbots
# DM_BRIDGE_SECRET entsprechen. Leer + 127.0.0.1 = klassischer Pfad-Modus ohne Secret.
DM_BRIDGE_SECRET=

# --- Security-Flags (Defaults erhalten das heutige Verhalten) ---

# SSRF-Schutz für !radio <url> und !next url||titel: off | warn | block
# warn (Default) = spielt wie bisher, loggt aber eine Warnung + Hinweis im Channel
# block = URLs auf private/loopback/link-local Adressen werden abgelehnt
URL_VALIDATION=warn

# Wiedergabe-steuernde Commands (!s, !stop, !clear, !eq, !seek, !now, !remove,
# !move, !shuffle) erfordern denselben Voice-Channel wie der Bot.
# false (Default) = kein Check. Der Bot-Owner ist immer ausgenommen.
REQUIRE_SAME_VOICE=false

# Wenn gesetzt (Discord-Rollen-ID): !radio delete/rename, !reloadcookies und
# !format nur für Mitglieder dieser Rolle ODER den Bot-Owner.
# Leer (Default) = kein Gating. Der Owner wird nie ausgesperrt.
ADMIN_ROLE_ID=

# Maximale Größe des downloads/-Ordners in MB (für Dauerbetrieb auf kleiner
# Platte). 0 oder leer (Default) = kein Cleanup, heutiges Verhalten.
# Wenn gesetzt: nach jedem Download werden die ältesten Dateien gelöscht,
# bis das Limit eingehalten ist. Songs in Queue/aktueller Wiedergabe sind tabu.
DOWNLOADS_MAX_MB=0
